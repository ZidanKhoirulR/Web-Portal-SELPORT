# =========================================================================
# SELPORT Environment Configuration Example
# Copy this file to .env and adjust the values for your environment.
# =========================================================================

# Database Configuration (Portal Main DB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portal_selport
DB_USER=root
DB_PASS=

# Database SIL 2020
DB_SIL_HOST=localhost
DB_SIL_PORT=3306
DB_SIL_NAME=sil2020
DB_SIL_USER=root
DB_SIL_PASS=

# Database Sertifikasi (serti2020)
DB_SERTI_HOST=localhost
DB_SERTI_PORT=3306
DB_SERTI_NAME=serti2020
DB_SERTI_USER=root
DB_SERTI_PASS=

# Database Kalibrasi (sikalib2024)
DB_KALIB_HOST=localhost
DB_KALIB_PORT=3306
DB_KALIB_NAME=sikalib2024
DB_KALIB_USER=root
DB_KALIB_PASS=

# Secret Key for Document Token Signing (Generate a strong random 64-char hex string)
DOC_SECRET=your_doc_signing_secret_key_here

# SMTP Configuration (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME="Portal SELPORT"
SMTP_FROM_EMAIL=your_email@gmail.com

# WhatsApp Gateway API (Wanotif or compatible)
WANOTIF_APIKEY=your_wanotif_api_key_here

